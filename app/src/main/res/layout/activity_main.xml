<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- Container for Zero-Distortion AutoFitTextureView -->
    <FrameLayout
        android:id="@+id/viewfinderContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true" />

    <!-- White Flash Overlay for Instant Shutter Feedback -->
    <View
        android:id="@+id/shutterFlashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:visibility="gone" />

    <!-- TOP BAR: Torch Selector & Beast Mode Switch -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="#99000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <!-- Universal Torch Button (Cycles: OFF -> ON -> AUTO) -->
        <Button
            android:id="@+id/btnTorch"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:backgroundTint="#222222"
            android:text="TORCH: OFF"
            android:textColor="#FFD700"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Beast Mode Toggle (Cycles: DAY BEAST <-> PRO NIGHT BEAST) -->
        <Button
            android:id="@+id/btnModeSwitch"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1.3"
            android:backgroundTint="#1B5E20"
            android:text="MODE: DAY BEAST"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- STATUS PILL: Displays Live Pipeline & 30s Cloud AI Progress -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/topBar"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="14dp"
        android:background="#CC111111"
        android:paddingHorizontal="18dp"
        android:paddingVertical="8dp"
        android:text="READY • POCO M6 PRO STUDIO"
        android:textColor="#00E676"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- BOTTOM BAR: Shutter Button & Processing Indicator -->
    <RelativeLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:layout_alignParentBottom="true"
        android:background="#99000000"
        android:padding="16dp">

        <!-- Main Shutter Button -->
        <Button
            android:id="@+id/btnCapture"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_centerInParent="true"
            android:backgroundTint="#FFFFFF"
            android:text="SHOT"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Background Cloud AI Spinner -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="28dp"
            android:indeterminateTint="#00E676"
            android:visibility="gone" />
    </RelativeLayout>

</RelativeLayout>
